# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler URI, used only by scripts/run-migrations.mjs and the seed.
# Not needed by the deployed app — see docs/01-DATABASE.md §14.
DATABASE_URL=

# The app's public origin, used to build auth redirect URLs.
# On Vercel this is optional: it falls back to the project's production
# domain automatically. Set it if you attach a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
